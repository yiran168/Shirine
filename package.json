{
  "name": "shirine",
  "version": "1.0.0",
  "private": true,
  "description": "Shirine - Dynamic Anime-Themed Blog Powered by Cloudflare Workers, D1, R2, and Astro",
  "author": "yiran168",
  "license": "MIT",
  "workspaces": [
    "client",
    "server",
    "docs"
  ],
  "scripts": {
    "dev:server": "bun run --cwd server dev",
    "dev:client": "bun run --cwd client dev",
    "dev:docs": "bun run --cwd docs dev",
    "build:server": "bun run --cwd server build",
    "build:client": "bun run --cwd client build",
    "build:docs": "bun run --cwd docs build",
    "build": "bun run build:server && bun run build:client && bun run build:docs",
    "deploy:server": "bun run scripts/deploy.ts --server",
    "deploy:client": "bun run scripts/deploy.ts --client",
    "deploy": "bun run scripts/deploy.ts",
    "db:migrate:local": "bun run --cwd server db:migrate:local",
    "db:migrate:remote": "bun run scripts/deploy.ts --migrate",
    "test": "bun test",
    "tsc": "bun run --cwd server tsc",
    "check": "bun run --cwd server tsc --noEmit && bun run --cwd client astro check"
  },
  "keywords": [
    "shirine",
    "blog",
    "astro",
    "cloudflare-workers",
    "cloudflare-d1",
    "cloudflare-r2",
    "cloudflare-pages",
    "material-3",
    "svelte-5"
  ],
  "devDependencies": {
    "drizzle-orm": "^0.45.2",
    "wrangler": "^3.86.0"
  }
}
