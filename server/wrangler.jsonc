{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shirine-server",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shirine-db",
      "database_id": "shirine-db-id"
    }
  ],
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "shirine-storage"
    }
  ],
  "vars": {
    "JWT_SECRET": "shirine_super_secret_jwt_key_2026",
    "PUBLIC_R2_URL": ""
  }
}
