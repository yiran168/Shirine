---
/**
 * 页脚（消费 blog/FooterBar 原子）。
 * 只负责配置数据：版权名称/年份、RSS/Atom/Sitemap 链接、Powered by、FooterConfig.html 文件注入。
 */
import FooterBar from "@components/atoms/blog/FooterBar.astro";
import { url } from "@utils/url-utils";
import { footerConfig, profileConfig } from "@/config";
import rawFooterHtml from "@/config/FooterConfig.html?raw";
import packageMetadata from "../../../package.json";

const currentYear = new Date().getFullYear();
const links = [
	{ label: "RSS", href: url("rss/") },
	{ label: "Atom", href: url("atom/") },
	{ label: "Sitemap", href: url("sitemap-index.xml"), external: true },
];
const isShirinesPackage = packageMetadata.name === "shirines";
const poweredBy = [
	{ label: "Astro", href: "https://astro.build", external: true },
	{
		label: "Shirine",
		href: "https://github.com/LyraVoid/Shirine",
		external: true,
	},
	...(isShirinesPackage
		? [
				{
					label: "shirines",
					href: "https://github.com/yCENzh/shirines",
					external: true,
				},
			]
		: []),
];

let customFooterHtml = "";
if (footerConfig.enable && rawFooterHtml) {
	try {
		const cleaned = rawFooterHtml.replace(/<!--[\s\S]*?-->/g, "").trim();
		if (cleaned) {
			customFooterHtml = cleaned;
		}
	} catch {
		customFooterHtml = "";
	}
}
---

<FooterBar
	name={profileConfig.name}
	year={currentYear}
	links={links}
	poweredBy={poweredBy}
	version={packageMetadata.version}
	versionHref={isShirinesPackage ? "https://www.npmjs.com/package/shirines" : "https://github.com/LyraVoid/Shirine"}
	customHtml={customFooterHtml}
/>
