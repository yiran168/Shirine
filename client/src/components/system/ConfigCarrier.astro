---
import { resolveTextureOptions } from "@/config";
import { getDynamicSiteConfig } from "@utils/dynamic-config";

const { site: siteConfig } = await getDynamicSiteConfig();
const textureOptions = resolveTextureOptions(siteConfig.texture, siteConfig.displaySettings?.texture);
---

<div
	id="config-carrier"
	data-hue={siteConfig.themeColor.hue}
	data-wallpaper-mode={siteConfig.wallpaperMode.defaultMode}
	{...(textureOptions.enable
		? {
				"data-texture-preset": textureOptions.defaultPreset,
				"data-texture-opacity": textureOptions.defaultOpacity,
			}
		: {})}
>
</div>
