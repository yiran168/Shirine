---
export const prerender = false;

import AdminDashboard from "@components/admin/AdminDashboard.svelte";
import Live2DControl from "@components/features/pio/Live2DControl.svelte";
import "@/styles/main.css";

const queryLang = Astro.url.searchParams.get("lang");
const cookieLang = Astro.cookies.get("shirine_admin_lang")?.value || Astro.cookies.get("shirine_lang")?.value || "zh_CN";
const currentAdminLang = queryLang || cookieLang;
const htmlLang = currentAdminLang.replace("_", "-");
---

<!doctype html>
<html lang={htmlLang} class="h-full">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Shirine 管理控制台</title>
		<link rel="icon" href="/logo/icon.webp" />
		<link rel="preload" href="/assets/images/furina-loading.svg" as="image" type="image/svg+xml" fetchpriority="high" />
		<script is:inline>
			const theme = localStorage.getItem('theme') || 'auto';
			if (theme === 'dark' || (theme === 'auto' && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
				document.documentElement.classList.add('dark');
			} else {
				document.documentElement.classList.remove('dark');
			}
			const hue = localStorage.getItem('hue') || '260';
			document.documentElement.style.setProperty('--hue', hue);
		</script>
	</head>
	<body class="h-full antialiased bg-[var(--surface-container-lowest,#f8fafc)] text-[var(--on-surface,#0f172a)]">
		<!-- Global Furina Anime Loading Screen for Admin Console -->
		<style is:inline>
			#furina-admin-loader {
				animation: furina-admin-loader-auto-fade 0.25s ease-out 0.4s forwards;
			}
			@keyframes furina-admin-loader-auto-fade {
				0% { opacity: 1; }
				99% { opacity: 0; pointer-events: none; }
				100% { opacity: 0; pointer-events: none; visibility: hidden; }
			}
		</style>
		<div
			id="furina-admin-loader"
			class="fixed inset-0 z-[99999] flex flex-col items-center justify-center bg-[var(--surface-container-lowest,#f8fafc)]/90 backdrop-blur-xl transition-all duration-300 ease-out select-none"
			aria-label="管理后台加载中..."
			role="status"
		>
			<div class="relative flex flex-col items-center justify-center max-w-[280px] sm:max-w-[340px] md:max-w-[380px] w-full px-4">
				<img
					src="/assets/images/furina-loading.svg"
					alt="Shirine Loading..."
					width="380"
					height="380"
					loading="eager"
					fetchpriority="high"
					class="w-full h-auto drop-shadow-xl pointer-events-none"
				/>
			</div>
		</div>
		<AdminDashboard client:only="svelte" />
		<Live2DControl client:only="svelte" mode="admin" />
		<script is:inline>
			const adminLoader = document.getElementById('furina-admin-loader');
			if (adminLoader) {
				let dismissed = false;
				const dismiss = () => {
					if (dismissed) return;
					dismissed = true;
					adminLoader.classList.add('opacity-0', 'pointer-events-none');
					setTimeout(() => {
						adminLoader.style.display = 'none';
						try { adminLoader.remove(); } catch {}
					}, 200);
				};
				if (document.readyState === 'complete' || document.readyState === 'interactive') {
					dismiss();
				} else {
					window.addEventListener('DOMContentLoaded', dismiss, { once: true });
					window.addEventListener('load', dismiss, { once: true });
				}
				setTimeout(dismiss, 500);
			}
		</script>
	</body>
</html>

<style lang="stylus" is:global>
@import "../../styles/variables.styl"
</style>

