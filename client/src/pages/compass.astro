---
export const prerender = false;

/**
 * 站点罗盘页：常用站点按分组陈列（支持后台动态配置与本地预设回退；
 * 搜索过滤 / 分组锚点滚动 / stagger 入场均为交互态）。
 */
import CompassSection from "@components/organisms/CompassSection.svelte";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getDynamicCompass } from "@utils/content-utils";

const shelves = await getDynamicCompass(Astro.request);
---

<MainGridLayout title={i18n(I18nKey.compass)} description={i18n(I18nKey.compassBanner)} page="compass">
    <CompassSection {shelves} client:visible></CompassSection>
</MainGridLayout>
