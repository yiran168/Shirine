---
export const prerender = false;
import AlbumSection from "@components/organisms/AlbumSection.svelte";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getDynamicAlbums } from "@utils/content-utils";

const albumsToUse = await getDynamicAlbums(Astro.request);
---

<MainGridLayout title={i18n(I18nKey.albums)} description={i18n(I18nKey.albumsBanner)} page="albums">
	<AlbumSection albums={albumsToUse} client:visible />
</MainGridLayout>
