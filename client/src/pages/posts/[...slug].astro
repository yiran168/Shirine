---
export const prerender = false;

import { type CollectionEntry, render } from "astro:content";
import path from "node:path";
import IconButton from "@components/atoms/action/IconButton.svelte";
import AccentBar from "@components/atoms/display/AccentBar.svelte";
import Card from "@components/atoms/display/Card.svelte";
import Markdown from "@components/content/Markdown.astro";
import ImageWrapper from "@components/molecules/ImageWrapper.astro";
import LastUpdatedNotice from "@components/molecules/LastUpdatedNotice.astro";
import License from "@components/molecules/License.astro";
import PostMetadata from "@components/molecules/PostMeta.astro";
import ArticleDiscovery from "@components/organisms/ArticleDiscovery.astro";
import ArticleShare from "@components/organisms/ArticleShare.svelte";
import CommentSection from "@components/organisms/comment/CommentSection.astro";
import EncryptedContent from "@components/organisms/EncryptedContent.astro";
import UmamiStats from "@components/organisms/UmamiStats.astro";
import PermissionBadge from "@components/permissions/PermissionBadge.svelte";
import CoverLockOverlay from "@components/permissions/CoverLockOverlay.svelte";
import PostUnlockCard from "@components/permissions/PostUnlockCard.svelte";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { discoverArticles } from "@utils/article-discovery";
import { resolveAsset } from "@utils/asset-utils";
import { getPublishedInstant, getUpdatedInstant } from "@utils/content-date";
import { getSortedPosts, type PostForList } from "@utils/content-utils";
import { formatDateToYYYYMMDD } from "@utils/date-utils";
import { getMarkdownStylesheetAssets } from "@utils/markdown-assets";
import { getSourceMarkdownSyntaxSnapshot } from "@utils/markdown-source-syntaxes.mjs";
import {
	hasMarkdownSyntax,
	mergeMarkdownSyntaxSnapshots,
} from "@utils/markdown-syntaxes.mjs";
import { initPostIdMap } from "@utils/permalink-utils";
import {
	getDir,
	getPostUrl,
	getPostUrlBySlug,
	removeFileExtension,
} from "@utils/url-utils";
import { Icon } from "astro-icon/components";
import katexStylesheet from "katex/dist/katex.css?url";
import overlayScrollbarsStylesheet from "overlayscrollbars/overlayscrollbars.css?url";
import { renderDynamicMarkdown } from "@utils/dynamic-markdown";
import {
	articleConfig,
	commentConfig,
	licenseConfig,
	profileConfig,
	resolveArticleDiscoveryOptions,
	resolveArticleShareOptions,
	resolveCommentOptions,
	resolveLastUpdatedNoticeOptions,
	resolveUmamiOptions,
	siteConfig,
	umamiConfig,
} from "@/config";

const { slug } = Astro.params;
if (!slug) {
	return Astro.redirect("/404");
}

const apiBase = import.meta.env.PUBLIC_API_URL || "http://localhost:11498/api";
const cookieHeader = Astro.request.headers.get("cookie") || "";
const authHeader = Astro.request.headers.get("authorization") || "";

const blogEntries = await getSortedPosts();
initPostIdMap(blogEntries);

let entry = blogEntries.find((cand) => {
	const defaultSlug = removeFileExtension(cand.id);
	if (defaultSlug === slug || cand.id === slug) return true;
	if (cand.data.alias) {
		let alias = cand.data.alias.replace(/^\/+/, "").replace(/\/+$/, "");
		if (alias.startsWith("posts/")) alias = alias.replace(/^posts\//, "");
		if (alias === slug) return true;
	}
	return false;
});

// Fetch authoritative post detail from backend API (#6, #7, #8)
let dynamicDetail: any = null;
let apiPostNotFound = false;
try {
	const res = await fetch(`${apiBase.replace(/\/$/, "")}/posts/${encodeURIComponent(slug)}`, {
		headers: {
			...(cookieHeader ? { cookie: cookieHeader } : {}),
			...(authHeader ? { authorization: authHeader } : {}),
		},
		signal: AbortSignal.timeout(3000),
	});
	if (res.ok) {
		const json = await res.json();
		if (json.success && (json.data || json.post)) {
			dynamicDetail = json.data || json.post;
		}
	} else if (res.status === 404) {
		apiPostNotFound = true;
	}
} catch (e) {
	console.error("Failed to fetch post detail from API:", e);
}

const isDynamicProd = Boolean(import.meta.env.PROD && import.meta.env.PUBLIC_API_URL);
if (isDynamicProd && (!dynamicDetail || apiPostNotFound)) {
	return Astro.redirect("/404");
}

// If post is not in local static markdown, create entry from dynamic detail
if (!entry && dynamicDetail) {
	entry = {
		id: dynamicDetail.slug || String(dynamicDetail.id),
		body: dynamicDetail.content || "",
		collection: "posts" as const,
		data: {
			title: dynamicDetail.title,
			published: new Date(dynamicDetail.createdAt),
			updated: dynamicDetail.updatedAt ? new Date(dynamicDetail.updatedAt) : undefined,
			description: dynamicDetail.description || "",
			image: dynamicDetail.image || "",
			category: dynamicDetail.category || "",
			tags: Array.isArray(dynamicDetail.tags) ? dynamicDetail.tags : [],
			pinned: Boolean(dynamicDetail.pinned),
			draft: Boolean(dynamicDetail.draft),
			comment: Boolean(dynamicDetail.commentEnabled ?? true),
			encrypted: false,
			permissionType: dynamicDetail.permissionType || "public",
			requiredPoints: dynamicDetail.requiredPoints || 0,
			isUnlocked: Boolean(dynamicDetail.isUnlocked),
			passwordHint: dynamicDetail.passwordHint,
			alias: dynamicDetail.alias,
			permalink: dynamicDetail.permalink,
			prevTitle: "",
			prevSlug: "",
			nextTitle: "",
			nextSlug: "",
			dbId: dynamicDetail.id,
		} as any,
	} as any;
}

if (!entry) {
	return Astro.redirect("/404");
}

// Update permission and content from authoritative backend detail
if (dynamicDetail) {
	(entry.data as any).isUnlocked = Boolean(dynamicDetail.isUnlocked);
	(entry.data as any).permissionType = dynamicDetail.permissionType;
	(entry.data as any).requiredPoints = dynamicDetail.requiredPoints;
	(entry.data as any).dbId = dynamicDetail.id;
	(entry.data as any).passwordHint = dynamicDetail.passwordHint;
	entry.body = dynamicDetail.content ?? "";
}

const discoveryCandidates = blogEntries.map((e) => ({
	slug: e.id,
	data: e.data,
}));
const discoveryOptions = resolveArticleDiscoveryOptions(articleConfig);

const current = discoveryCandidates.find(
	(candidate) => candidate.slug === entry.id,
);
const discovery =
	discoveryOptions && current
		? discoverArticles(
				current,
				discoveryCandidates,
				discoveryOptions.relatedCount,
				discoveryOptions.randomCount,
			)
		: { related: [], random: [] };

const isEncrypted = Boolean(
	entry.data.password && entry.data.password.trim().length > 0,
);
const scope = `post:${entry.id}`;

let Content: any = null;
let headings: any[] = [];
let remarkPluginFrontmatter: any = { words: 0, minutes: 0, markdownSyntaxes: [] };
let dynamicHtml = "";

try {
	const rendered = await render(entry);
	Content = rendered.Content;
	headings = rendered.headings;
	remarkPluginFrontmatter = rendered.remarkPluginFrontmatter;
} catch {
	dynamicHtml = renderDynamicMarkdown(entry.body);
	const words = entry.body.length;
	remarkPluginFrontmatter = {
		words,
		minutes: Math.ceil(words / 300) || 1,
		markdownSyntaxes: [],
	};
}

const renderedMarkdownSyntaxes = remarkPluginFrontmatter?.markdownSyntaxes || [];
const sourceMarkdownSyntaxes = hasMarkdownSyntax(
	renderedMarkdownSyntaxes,
	"expressive-code",
)
	? undefined
	: getSourceMarkdownSyntaxSnapshot(entry.body);
const markdownSyntaxes = mergeMarkdownSyntaxSnapshots(
	renderedMarkdownSyntaxes,
	sourceMarkdownSyntaxes,
);
const hasMath = hasMarkdownSyntax(markdownSyntaxes, "math");
const markdownStylesheetAssets =
	await getMarkdownStylesheetAssets(markdownSyntaxes);
const effectiveHeadings = isEncrypted ? [] : (headings || []);
const imageBasePath = entry.filePath
	? path.relative(path.resolve("src"), path.dirname(entry.filePath))
	: path.join("content/posts/", getDir(entry.id));
const effectiveUpdatedDate = entry.data.updated ?? entry.data.published;
const publishedInstant = getPublishedInstant(entry.data);
const updatedInstant = getUpdatedInstant(entry.data);
const postCommentEnabled =
	entry.data.comment !== false && Boolean(resolveCommentOptions(commentConfig));
const lastUpdatedNotice = resolveLastUpdatedNoticeOptions(articleConfig);
const shareOptions = resolveArticleShareOptions(articleConfig);
const umamiEnabled = resolveUmamiOptions(umamiConfig) !== null;
const authorAvatarUrl = shareOptions
	? await resolveAsset(profileConfig.avatar ?? "")
	: "";

const effectiveDescription =
	isEncrypted && entry.data.hideHomeContent
		? i18n(I18nKey.postEncryptedSummary)
		: entry.data.description || entry.data.title;
const ogImage = entry.data.image
	? await resolveAsset(entry.data.image, imageBasePath)
	: undefined;

const canonicalPostUrl = getPostUrl(entry);

// Permission check (P0-02, P0-03)
const permissionType = (entry.data as any).permissionType || "public";
const requiredPoints = (entry.data as any).requiredPoints || 0;
const isUnlocked = Boolean((entry.data as any).isUnlocked);
const dbId = Number((entry.data as any).dbId || (entry.data as any).id || (dynamicDetail?.id ?? 0));

const isLocked = dynamicDetail ? Boolean(dynamicDetail.isLocked) : (permissionType !== "public" && !isUnlocked);
if (isLocked) {
	entry.body = "";
}

// Ensure sensitive or dynamic protected content is never edge-cached
const isSensitive = Boolean(isLocked || permissionType !== "public" || dynamicDetail?.permissionType !== "public" || (entry.data as any).encrypted || cookieHeader.includes("shirine_"));
if (isSensitive) {
	Astro.response.headers.set("Cache-Control", "private, no-cache, no-store, must-revalidate");
	Astro.response.headers.set("Pragma", "no-cache");
	Astro.response.headers.set("Expires", "0");
}

function serializeJsonLd(data: any): string {
	return JSON.stringify(data)
		.replace(/</g, "\\u003c")
		.replace(/>/g, "\\u003e")
		.replace(/&/g, "\\u0026");
}

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	headline: entry.data.title,
	description: effectiveDescription,
	keywords: entry.data.tags,
	author: {
		"@type": "Person",
		name: profileConfig.name,
		url: Astro.site,
	},
	datePublished: entry.data.publishedAt
		? publishedInstant.toISOString()
		: formatDateToYYYYMMDD(entry.data.published),
	dateModified: entry.data.updatedAt
		? updatedInstant.toISOString()
		: formatDateToYYYYMMDD(effectiveUpdatedDate),
	inLanguage: entry.data.lang
		? entry.data.lang.replace("_", "-")
		: siteConfig.lang.replace("_", "-"),
};
---

<MainGridLayout banner={entry.data.image} ogImage={ogImage} title={entry.data.title} description={effectiveDescription} bannerDate={formatDateToYYYYMMDD(entry.data.published)} lang={entry.data.lang} setOGTypeArticle={true} headings={effectiveHeadings} postCategory={entry.data.category || undefined} page="post" hasComments={postCommentEnabled}>
    {hasMath && <link slot="head" rel="stylesheet" data-swup-optional="math" href={katexStylesheet} />}
    {hasMath && <link slot="head" rel="stylesheet" data-swup-optional="math" href={overlayScrollbarsStylesheet} />}
    {markdownStylesheetAssets.map(({ pack, css }) => <style is:inline slot="head" data-swup-optional={pack} set:html={css}></style>)}
    <script is:inline slot="head" type="application/ld+json" set:html={serializeJsonLd(jsonLd)}></script>
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative mb-4" data-no-swup-cache={isSensitive ? "true" : undefined}>
		<Card color="var(--card-bg)" radius="l" class="post-card z-10 px-6 md:px-9 pt-6 pb-4 relative w-full">
			<!-- word count and reading time -->
			<div class="flex flex-row text-[var(--on-surface-variant)] gap-5 mb-3 transition onload-animation">
				<div class="flex flex-row items-center">
					<div class="transition h-6 w-6 rounded-md bg-[var(--surface-container-high)] text-[var(--on-surface-variant)] flex items-center justify-center mr-2">
						<Icon name="material-symbols:notes-rounded"></Icon>
					</div>
					<div class="text-sm">{remarkPluginFrontmatter.words} {" " + i18n(remarkPluginFrontmatter.words === 1 ? I18nKey.wordCount : I18nKey.wordsCount)}</div>
				</div>
				<div class="flex flex-row items-center">
					<div class="transition h-6 w-6 rounded-md bg-[var(--surface-container-high)] text-[var(--on-surface-variant)] flex items-center justify-center mr-2">
						<Icon name="material-symbols:schedule-outline-rounded"></Icon>
					</div>
					<div class="text-sm">{remarkPluginFrontmatter.minutes} {" " + i18n(remarkPluginFrontmatter.minutes === 1 ? I18nKey.minuteCount : I18nKey.minutesCount)}</div>
				</div>
				{umamiEnabled && (
					<div class="flex flex-row items-center">
						<UmamiStats variant="meta" path={canonicalPostUrl} />
					</div>
				)}
			</div>

			<!-- title -->
			<div class="relative onload-animation">
				<div
					data-pagefind-body data-pagefind-weight="10" data-pagefind-meta="title"
					class="transition w-full block font-bold mb-3
					text-3xl md:text-[2.25rem]/[2.75rem]
					text-[var(--on-surface)]
					flex items-center gap-3"
				>
					<AccentBar size="large" />
					<div class="inline-flex items-center gap-2.5 flex-wrap">
						<span>{entry.data.title}</span>
						{permissionType !== "public" && (
							<PermissionBadge client:load type={permissionType} points={requiredPoints} />
						)}
					</div>
					<IconButton
						id="copy-post-link"
						label={i18n(I18nKey.copyLink)}
						class="ml-auto shrink-0"
					>
						<Icon name="material-symbols:link-rounded" class="text-[1.25rem]" />
					</IconButton>
				</div>
			</div>

			<!-- metadata -->
			<div class="onload-animation">
				{isEncrypted && entry.data.hideHomeContent ? (
					<div class="flex flex-wrap items-center gap-2 mb-5">
						<div class="flex items-center gap-1.5 px-3 py-1 rounded-full bg-[var(--surface-container-highest)] text-xs font-semibold text-[var(--primary)]">
							<Icon name="material-symbols:lock-rounded" class="text-sm" />
							<span>{i18n(I18nKey.postEncryptedBadge)}</span>
						</div>
					</div>
				) : (
					<PostMetadata
						class="mb-5"
						published={entry.data.published}
						updated={entry.data.updated}
						tags={entry.data.tags}
						category={entry.data.category}
					></PostMetadata>
				)}
				{!entry.data.image && <div class="border-[var(--line-divider)] border-dashed border-b-[1px] mb-5"></div>}
			</div>

            <!-- cover with lock overlay if locked -->
			{entry.data.image &&
				<div class="relative mb-8 rounded-xl overflow-hidden banner-container onload-animation">
					<ImageWrapper
						id="post-cover"
						src={entry.data.image}
						basePath={imageBasePath}
						class="w-full"
						loading="eager"
						fetchPriority="high"
						widths={[360, 720, 1080, 1440]}
						sizes="(min-width: 1280px) 720px, (min-width: 768px) calc(100vw - 22rem), calc(100vw - 3.5rem)"
						formats={["avif", "webp"]}
						quality={65}
					/>
					{isLocked && (
						<CoverLockOverlay client:load type={permissionType} points={requiredPoints} />
					)}
				</div>
			}

            {isLocked ? (
				<PostUnlockCard
					client:load
					postId={dbId}
					permissionType={permissionType}
					requiredPoints={requiredPoints}
					lockReason={dynamicDetail?.lockReason}
					passwordHint={dynamicDetail?.passwordHint || (entry.data as any).passwordHint}
				/>
			) : isEncrypted ? (
                <EncryptedContent
                    password={entry.data.password!}
                    scope={scope}
                    hint={entry.data.passwordHint}
                >
                    {Content ? <Content /> : <div class="prose max-w-none text-[var(--on-surface)]" set:html={dynamicHtml} />}
                </EncryptedContent>
            ) : Content ? (
                <Markdown class="mb-6 onload-animation">
                    <Content />
                </Markdown>
            ) : (
				<div class="mb-6 onload-animation prose prose-neutral dark:prose-invert max-w-none text-[var(--on-surface)] leading-relaxed" set:html={dynamicHtml}></div>
			)}

			{licenseConfig.enable && <License title={entry.data.title} slug={entry.id} pubDate={entry.data.published} class="mb-6 rounded-xl license-container onload-animation"></License>}

			{shareOptions && (
				<ArticleShare
					client:visible
					options={shareOptions}
					title={entry.data.title}
					description={effectiveDescription}
					author={profileConfig.name}
					published={formatDateToYYYYMMDD(entry.data.published)}
					siteTitle={siteConfig.title}
					postPath={canonicalPostUrl}
					coverSelector={entry.data.image ? "#post-cover img" : undefined}
					avatarUrl={authorAvatarUrl}
					class="mb-6 rounded-xl onload-animation"
				/>
			)}

			<ArticleDiscovery
				related={discovery.related}
				random={discovery.random}
				class="onload-animation"
			/>

		</Card>
    </div>

    <CommentSection
        context={{
            key: `post:${entry.id}`,
            path: canonicalPostUrl,
            title: entry.data.title,
            language: entry.data.lang || siteConfig.lang,
        }}
        postCommentEnabled={entry.data.comment}
        class="onload-animation"
    />

    {lastUpdatedNotice && (
        <LastUpdatedNotice
            date={updatedInstant}
            minimumAgeDays={lastUpdatedNotice.minimumAgeDays}
            class="mb-4 onload-animation"
        />
    )}

    <div class="flex flex-col md:flex-row justify-between mb-4 gap-4 overflow-hidden w-full">
        {entry.data.nextSlug ? (
            <Card
                href={entry.data.nextUrl || getPostUrlBySlug(entry.data.nextSlug)}
                color="var(--card-bg)"
                radius="l"
                class="post-nav post-nav--prev w-full font-bold active:scale-95 h-[3.75rem] max-w-full px-4 !flex items-center !justify-start gap-4"
            >
                <Icon name="material-symbols:chevron-left-rounded" class="post-nav__arrow text-[2rem] text-[var(--primary)]" />
                <div class="post-nav__title overflow-hidden transition overflow-ellipsis whitespace-nowrap max-w-[calc(100%_-_3rem)] text-75">
                    {entry.data.nextTitle}
                </div>
            </Card>
        ) : (
            <div class="w-full"></div>
        )}

        {entry.data.prevSlug ? (
            <Card
                href={entry.data.prevUrl || getPostUrlBySlug(entry.data.prevSlug)}
                color="var(--card-bg)"
                radius="l"
                class="post-nav post-nav--next w-full font-bold active:scale-95 h-[3.75rem] max-w-full px-4 !flex items-center !justify-end gap-4"
            >
                <div class="post-nav__title overflow-hidden transition overflow-ellipsis whitespace-nowrap max-w-[calc(100%_-_3rem)] text-75">
                    {entry.data.prevTitle}
                </div>
                <Icon name="material-symbols:chevron-right-rounded" class="post-nav__arrow text-[2rem] text-[var(--primary)]" />
            </Card>
        ) : (
            <div class="w-full"></div>
        )}
    </div>

</MainGridLayout>

<style is:global lang="stylus">
	.post-nav
		.post-nav__arrow
			transition: transform var(--m3e-duration-medium) var(--m3e-easing-emphasized-decelerate)

		.post-nav__title
			transition: color var(--m3e-duration-short) var(--m3e-easing-standard)

		&:hover .post-nav__title
			color: var(--primary)

		&--prev:hover .post-nav__arrow
			transform: translateX(-0.25rem)

		&--next:hover .post-nav__arrow
			transform: translateX(0.25rem)
</style>
