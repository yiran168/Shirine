---
export const prerender = false;

import Pagination from "@components/molecules/Pagination.astro";
import PostPage from "@components/organisms/PostPage.astro";
import { postListConfig } from "@/config/postListConfig";
import MainGridLayout from "../../layouts/MainGridLayout.astro";
import { getSortedPosts } from "../../utils/content-utils";

const { page: pageParam } = Astro.params;

// Only match pure numeric pagination params (e.g. /page/2/, /page/3/)
if (!pageParam || !/^\d+$/.test(pageParam)) {
	return Astro.redirect("/404/");
}

const currentPage = parseInt(pageParam, 10);
if (currentPage <= 1) {
	return Astro.redirect("/");
}

const allBlogPosts = await getSortedPosts(Astro.request);
const pageSize = postListConfig.pageSize || 10;
const total = allBlogPosts.length;
const totalPages = Math.max(1, Math.ceil(total / pageSize));

if (currentPage > totalPages) {
	return Astro.redirect(totalPages === 1 ? "/" : `/page/${totalPages}/`);
}

const start = (currentPage - 1) * pageSize;
const pagePosts = allBlogPosts.slice(start, start + pageSize);

const page = {
	data: pagePosts,
	start,
	end: Math.min(start + pageSize - 1, total - 1),
	total,
	currentPage,
	size: pageSize,
	lastPage: totalPages,
	url: {
		current: `/page/${currentPage}/`,
		next: currentPage < totalPages ? `/page/${currentPage + 1}/` : undefined,
		prev: currentPage === 2 ? "/" : `/page/${currentPage - 1}/`,
		first: "/",
		last: `/page/${totalPages}/`,
	},
} as any;

const len = pagePosts.length;
---

<MainGridLayout page="home">
    <PostPage page={page}></PostPage>
    <Pagination class="mx-auto onload-animation" page={page} style={`animation-delay: calc(var(--content-delay) + ${(len)*50}ms)`}></Pagination>
</MainGridLayout>
